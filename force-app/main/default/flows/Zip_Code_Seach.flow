<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Call_Zip_Code_API</name>
        <label>Call Zip Code API</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>ZipCodeFlowAdapter</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Is_US_Code</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error</targetReference>
        </faultConnector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>countryCode</name>
            <value>
                <elementReference>frFinalCountryCode</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>zipCode</name>
            <value>
                <elementReference>Zip_Code_Input</elementReference>
            </value>
        </inputParameters>
        <nameSegment>ZipCodeFlowAdapter</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>CA</name>
        <choiceText>Canada</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>CA</stringValue>
        </value>
    </choices>
    <choices>
        <name>DE</name>
        <choiceText>Germany</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>DE</stringValue>
        </value>
    </choices>
    <choices>
        <name>MX</name>
        <choiceText>Mexico</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>MX</stringValue>
        </value>
    </choices>
    <choices>
        <name>OTHER</name>
        <choiceText>Other (Enter ISO Code)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>OTHER</stringValue>
        </value>
    </choices>
    <choices>
        <name>US</name>
        <choiceText>United States</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>US</stringValue>
        </value>
    </choices>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Is_US_Code</name>
        <label>Is US Code?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Non_US_Details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Is Other Country</defaultConnectorLabel>
        <rules>
            <name>Yes_ISUSCODE</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Call_Zip_Code_API.isUS</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>US_Details</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>extracts the country ISO code from the picklist or the Other text option (if selected) and passes as ext</description>
        <name>frFinalCountryCode</name>
        <dataType>String</dataType>
        <expression>IF(
    {!Country} = &apos;OTHER&apos;, 
    UPPER(TRIM({!Custom_Country_Input})), 
CASE(
        {!Country},
        &apos;United States&apos;, &apos;US&apos;,
        &apos;Mexico&apos;, &apos;MX&apos;,
        &apos;Canada&apos;, &apos;CA&apos;,
        &apos;Germany&apos;, &apos;DE&apos;,
        &apos;US&apos;
    )
)</expression>
    </formulas>
    <interviewLabel>Zip Code Seach {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Zip Code Seach</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <name>Error</name>
        <label>Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Zip_Code_Search</targetReference>
        </connector>
        <fields>
            <name>Error_Message</name>
            <fieldText>&lt;p style=&quot;text-align: center;&quot;&gt;An error occurred while fetching zip code details: &lt;span style=&quot;color: rgb(176, 7, 7);&quot;&gt;{!$Flow.FaultMessage}&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Try Again</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Non_US_Details</name>
        <label>Non-US Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Zip_Code_Search</targetReference>
        </connector>
        <fields>
            <name>Details_nonUS</name>
            <fieldText>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong style=&quot;color: rgb(88, 186, 18);&quot;&gt;Non-US search processed and logged successfully to database.&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Search Again</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>US_Details</name>
        <label>US Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Zip_Code_Search</targetReference>
        </connector>
        <fields>
            <name>Details</name>
            <fieldText>&lt;h3&gt;US Zip Code Details&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;Post Code:&lt;/strong&gt; {!Call_Zip_Code_API.zipCode}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Country:&lt;/strong&gt; {!Call_Zip_Code_API.country}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Places:&lt;/strong&gt; {!Call_Zip_Code_API.placeName}&lt;/p&gt;&lt;h4&gt;&lt;br&gt;&lt;/h4&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Search Again</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Zip_Code_Search</name>
        <label>Zip Code Search</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Call_Zip_Code_API</targetReference>
        </connector>
        <fields>
            <name>Zip_Code_Search_Section1</name>
            <fieldType>RegionContainer</fieldType>
            <fields>
                <name>Zip_Code_Search_Section1_Column1</name>
                <fieldType>Region</fieldType>
                <fields>
                    <name>Country</name>
                    <choiceReferences>US</choiceReferences>
                    <choiceReferences>MX</choiceReferences>
                    <choiceReferences>CA</choiceReferences>
                    <choiceReferences>DE</choiceReferences>
                    <choiceReferences>OTHER</choiceReferences>
                    <dataType>String</dataType>
                    <fieldText>Country</fieldText>
                    <fieldType>DropdownBox</fieldType>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>false</isRequired>
                </fields>
                <inputParameters>
                    <name>width</name>
                    <value>
                        <stringValue>12</stringValue>
                    </value>
                </inputParameters>
                <isRequired>false</isRequired>
            </fields>
            <isRequired>false</isRequired>
            <regionContainerType>SectionWithoutHeader</regionContainerType>
        </fields>
        <fields>
            <name>Zip_Code_Search_Section2</name>
            <fieldType>RegionContainer</fieldType>
            <fields>
                <name>Zip_Code_Search_Section2_Column1</name>
                <fieldType>Region</fieldType>
                <fields>
                    <name>Custom_Country_Input</name>
                    <dataType>String</dataType>
                    <defaultValue>
                        <stringValue>Enter 2-Letter Country Code (e.g., FR, GB, JP)</stringValue>
                    </defaultValue>
                    <fieldText>2-Letter Country Code</fieldText>
                    <fieldType>InputField</fieldType>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>false</isRequired>
                    <validationRule>
                        <errorMessage>&lt;p&gt;Please enter a valid 2-letter ISO country code.&lt;/p&gt;</errorMessage>
                        <formulaExpression>LEN({!Custom_Country_Input}) = 2</formulaExpression>
                    </validationRule>
                    <visibilityRule>
                        <conditionLogic>and</conditionLogic>
                        <conditions>
                            <leftValueReference>Country</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <elementReference>OTHER</elementReference>
                            </rightValue>
                        </conditions>
                    </visibilityRule>
                </fields>
                <inputParameters>
                    <name>width</name>
                    <value>
                        <stringValue>12</stringValue>
                    </value>
                </inputParameters>
                <isRequired>false</isRequired>
            </fields>
            <isRequired>false</isRequired>
            <regionContainerType>SectionWithoutHeader</regionContainerType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Country</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>OTHER</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Zip_Code_Search_Section3</name>
            <fieldType>RegionContainer</fieldType>
            <fields>
                <name>Zip_Code_Search_Section3_Column1</name>
                <fieldType>Region</fieldType>
                <fields>
                    <name>Zip_Code_Input</name>
                    <dataType>String</dataType>
                    <fieldText>Enter Zip Code</fieldText>
                    <fieldType>InputField</fieldType>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>true</isRequired>
                </fields>
                <inputParameters>
                    <name>width</name>
                    <value>
                        <stringValue>12</stringValue>
                    </value>
                </inputParameters>
                <isRequired>false</isRequired>
            </fields>
            <isRequired>false</isRequired>
            <regionContainerType>SectionWithoutHeader</regionContainerType>
        </fields>
        <nextOrFinishButtonLabel>Search</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Zip_Code_Search</targetReference>
        </connector>
    </start>
    <status>Draft</status>
</Flow>
